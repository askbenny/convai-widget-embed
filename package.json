{
  "name": "@askbenny/convai-widget-embed",
  "version": "1.5.0",
  "description": "The Conversational AI Widget bundled with all dependencies for easy embedding.",
  "main": "./dist/index.js",
  "unpkg": "./dist/index.js",
  "source": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --mode website && node scripts/runtime-manifest.mjs",
    "build:analyze": "ANALYZE=true vite build",
    "check-types": "tsc --noEmit --skipLibCheck",
    "lint:es": "pnpm exec eslint .",
    "lint:prettier": "prettier 'src/**/*.ts'",
    "test": "vitest run",
    "test:release": "node --test scripts/tests/*.node.mjs",
    "release:prepare": "node scripts/release.mjs prepare",
    "sync:core": "node scripts/sync-core.mjs"
  },
  "keywords": [],
  "author": "ElevenLabs",
  "license": "MIT",
  "devDependencies": {
    "@askbenny/convai-widget-core": "file:vendor/askbenny-convai-widget-core-1.5.0.tgz",
    "eslint": "^9.8.0",
    "typescript": "^5.5.4",
    "vite": "^7.3.1",
    "vite-bundle-analyzer": "^1.3.2",
    "vitest": "3.2.4",
    "yaml": "2.8.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/askbenny/convai-widget-embed.git",
    "directory": "packages/convai-widget-embed"
  },
  "packageManager": "pnpm@10.32.1",
  "files": [
    "dist"
  ]
}
